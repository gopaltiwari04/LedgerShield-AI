# ==============================================================================
# LedgerShield AI - Environment Configuration Example
# ==============================================================================

# Database
# Default: SQLite dev database for rapid local development
# Production: PostgreSQL connection string with connection pooling
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/ledgershield?schema=public&sslmode=require"

# Application Settings
NEXT_PUBLIC_APP_NAME="LedgerShield AI"
NEXT_PUBLIC_APP_TAGLINE="B2B Financial Leakage & Procurement Fraud Investigation Platform"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_ENABLE_DEMO_SEED="false"

# ------------------------------------------------------------------------------
# Generative AI Provider (Mandatory: Google Gemini)
# Obtain key at: https://aistudio.google.com/
# Supported models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# Document Storage Driver
# "local" for development, "s3" for AWS S3 / Cloudflare R2 in production
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./uploads"

# S3 / Cloudflare R2 Credentials (required if STORAGE_DRIVER="s3")
# S3_ENDPOINT="" # Leave empty for AWS S3; set for Cloudflare R2 or MinIO
# S3_REGION="ap-south-1"
# S3_BUCKET_NAME="ledgershield-documents"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Transactional Email Provider
# "resend" or "smtp" for production delivery; "mock" logs to database/console
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="mock" # "mock" | "resend" | "smtp"
RESEND_API_KEY=""
EMAIL_FROM="noreply@ledgershield.ai"

# SMTP Configuration (if EMAIL_PROVIDER="smtp")
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ------------------------------------------------------------------------------
# Security & Authentication
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
AUTH_SECRET="dev-insecure-secret-key-change-in-production-min-32-chars"
SESSION_EXPIRY_DAYS="7"
